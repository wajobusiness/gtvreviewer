# ==============================================================================
# UK GLOBAL TALENT VISA AUDIT PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Storage Driver: "local" (default filesystem reads) or "database" (PostgreSQL / Supabase)
STORAGE_DRIVER=local

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Required when STORAGE_DRIVER=database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audit_db?schema=public

# Object Storage / AWS S3 / Cloudflare R2 (For document PDFs and report uploads)
S3_BUCKET=global-talent-audits
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com

# Authentication (Phase 2 - Clerk or Supabase)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Stripe Billing (Phase 4)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

