# ==============================================================================
# UK GLOBAL TALENT VISA AUDIT PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. DATABASE & STORAGE (Neon PostgreSQL / Local Driver)
# ------------------------------------------------------------------------------
# Set STORAGE_DRIVER to "database" for Neon PostgreSQL persistence, or "local"
STORAGE_DRIVER=database

# Neon PostgreSQL connection string (pooled recommended for serverless)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AI SERVICE LAYER CONFIGURATION
# ------------------------------------------------------------------------------
# AI Provider: "gemini" (default) | "openai" | "anthropic"
# The system connects to the chosen provider server-side without leaking keys.
AI_PROVIDER=gemini

# Google Gemini API Configuration (Recommended default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude API Configuration (Optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 3. OPTIONAL OBJECT STORAGE & INTEGRATIONS
# ------------------------------------------------------------------------------
# AWS S3 / Cloudflare R2 / MinIO (Optional - for direct binary archive storage)
# S3_BUCKET=
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
